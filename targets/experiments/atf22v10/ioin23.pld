Device   g22v10;

/* Pin 23 is never driven -- it is used only as an INPUT to pin 22.
   Does an I/O pin reach the array without its own macrocell producing
   an output, and through which column? Measured for every macrocell
   rather than generalised from one, because "an I/O pin can be an
   input" is a claim about ten pins. */

PIN 23 = a;
PIN 22 = o0;

o0 = a;
