/* Which row block and which S0/S1 pair belong to pin 18?
   With mc14/mc17/mc20 and the pin 22/23 designs, this completes
   all ten macrocells, so neither table is interpolated. */
PIN 2  = i0;
PIN 18 = o0;

o0 = i0;
