PIN 2 = i1;
PIN 3 = i2;
PIN 4 = i3;
PIN 5 = i4;
PIN 6 = i5;
PIN 7 = i6;
PIN 8 = i7;
PIN 14 = o0;

o0 = i0 # i1 # i2 # i3 # i4 # i5 # i6 # i7;
