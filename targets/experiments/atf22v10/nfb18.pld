Device   g22v10;

/* Complement of a FEEDBACK literal. The complement column was
   measured on input pins only and generalised to all 22 sources;
   feedback sources needed their own measurement. */
PIN 2  = i0;
PIN 18 = q;
PIN 23 = o0;

q  = i0;
o0 = !q;
