Device   g22v10;

/* SPEC.md 7.4, capacity. Pin 23 owns rows 1-9: one output-enable row and eight data rows. A sum of eight distinct single literals is already minimal SOP -- CUPL cannot merge the terms -- so this needs exactly eight product terms and must fit. */

PIN 1 = i0;
PIN 2 = i1;
PIN 3 = i2;
PIN 4 = i3;
PIN 5 = i4;
PIN 6 = i5;
PIN 7 = i6;
PIN 8 = i7;
PIN 23 = o0;

o0 = i0 # i1 # i2 # i3 # i4 # i5 # i6 # i7;
